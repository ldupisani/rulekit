# benchmark data never enters version control (the firewall)
# no trailing slash: in linked worktrees, data may be a SYMLINK to the main
# checkout and the dir-only pattern would not match it
projects/*/data
projects/*/snapshots
.rulekit-cache/

__pycache__/
*.pyc
.venv/
dist/
.pytest_cache/
node_modules/
*.DS_Store
